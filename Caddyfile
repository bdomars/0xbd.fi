{
	# TLS and routing are handled by Traefik in front of this server
	admin off
	auto_https off
	persist_config off

	# Use the client IP from Traefik's X-Forwarded-For. Only cluster-internal
	# traffic can reach this server, so trusting private ranges is safe.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server
	log

	header {
		Access-Control-Allow-Origin *
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'self' 0xbd.fi *.0xbd.fi; script-src 'self' 'unsafe-inline' https://gc.zgo.at; connect-src 'self' https://bdomars.goatcounter.com; img-src 'self' 0xbd.fi *.0xbd.fi https://bdomars.goatcounter.com; style-src 'self' 'unsafe-inline' 0xbd.fi *.0xbd.fi https://cdnjs.cloudflare.com/ https://fonts.googleapis.com https://use.fontawesome.com/; font-src 'self' 0xbd.fi *.0xbd.fi https://use.fontawesome.com/ https://fonts.gstatic.com/; frame-src 'none'; object-src 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self)"
		Strict-Transport-Security "max-age=31536000; includeSubdomains; preload"
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
